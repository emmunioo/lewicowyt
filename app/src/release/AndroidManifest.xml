<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Ten odbiornik jest przeznaczony wyłącznie dla diagnostyki ADB.
             W publicznym APK nie jest potrzebny. ProfileInstallReceiver
             pozostaje chroniony systemowym android.permission.DUMP. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
    </application>

</manifest>
